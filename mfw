-----END PGP PUBLIC KEY BLOCK-----'

### ARGUMENTS ###
cmd="$1"
proto="$2"
port="$3"

### HELP ###
help() {
  local cmd="$1"

  case "$cmd" in
    add)        help_add ;;
    del)        help_del ;;
    status)     help_status ;;
    reload)     help_reload ;;
    configure)  help_configure ;;
    update)     help_update ;;
    ""|help|*)  help_main ;;
  esac

  exit 1
}

help_main() {
  cat <<EOF
Usage:
  mfw <command> [options]

Available Commands:
  version        Prints the current version
  add            Adds a TCP or UDP port forwarding rule
  delete         Removes an existing forwarding rule
  status         Lists all configured forwarding rules and current config
  reload         Reloads and reapplies all firewall rules
  configure      Starts the interactive configuration wizard
  update         Checks for a newer version and updates if available
EOF
}

help_add() {
  cat <<EOF
Usage:
  mfw add <tcp|udp> <port>

Aliases:
  add, a

Adds a TCP or UDP port forwarding rule. You may specify a single port
or a port range using the format "start-end" (example: 12621-12631).

Examples:
  mfw add tcp 25565
  mfw add udp 12621-12631
EOF
}

help_del() {
  cat <<EOF
Usage:
  mfw del <tcp|udp> <port>

Aliases:
  delete, del, d

Removes an existing forwarding rule. If the rule was added as a range,
pass the same range to remove it (exact match required).

Examples:
  mfw del udp 16261
  mfw del tcp 12621-12631
EOF
}

help_status() {
  cat <<EOF
Usage:
  mfw status

Aliases:
  status, s

Lists all configured forwarding rules and active configuration.
EOF
}

help_reload() {
  cat <<EOF
Usage:
  mfw reload

Aliases:
  reload, r

Reloads and reapplies all firewall rules.
EOF
}

help_configure() {
  cat <<EOF
Usage:
  mfw configure

Aliases:
  configure, config

Starts the interactive configuration wizard.
EOF
}

help_update() {
  cat <<EOF
Usage:
  mfw update

Checks GitHub for a newer release and, if one is found, downloads it,
verifies its GPG signature against the key embedded in this binary, and
only then replaces the current installation.

The update is aborted if:
  - the signature file is missing or invalid
  - the signature does not match the downloaded file
  - the signing key fingerprint does not match the expected value

The running configuration and rules are always preserved.
EOF
}

### BOOTSTRAP ###
mkdir -p "$STATE_DIR"
touch "$STATE_FILE"
chmod 600 "$STATE_FILE"

### CONFIG LOAD ###
load_config() {
  # shellcheck source=/dev/null
  [[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
}

### DERIVE NETWORK BASED ON CIDR ###
derive_network() {
  DEST_HOST_IP="${DEST_IP%%/*}"
  CIDR_MASK="${DEST_IP##*/}"

  IFS=. read -r i1 i2 i3 i4 <<< "$DEST_HOST_IP"

  IP=$(( (i1<<24) | (i2<<16) | (i3<<8) | i4 ))
  MASK=$(( (0xFFFFFFFF << (32 - CIDR_MASK)) & 0xFFFFFFFF ))
  NET=$(( IP & MASK ))

  NET_IP=$(printf "%d.%d.%d.%d" \
    $(( (NET >> 24) & 255 )) \
    $(( (NET >> 16) & 255 )) \
    $(( (NET >> 8) & 255 )) \
    $(( NET & 255 ))
  )

  DEST_NET="$NET_IP/$CIDR_MASK"
}

### VALIDATION ###
require_config() {
  [[ -z "$PUBLIC_IF" || -z "$DEST_IF" || -z "$DEST_IP" ]] && {
    echo "✖ Incomplete configuration."
    echo "  Run: mfw configure"
    exit 1
  }

  derive_network
}

# Validate protocol: must be tcp or udp
is_valid_proto() {
  [[ "$1" =~ ^(tcp|udp)$ ]]
}

# Validate a single port or a port range (start-end). Returns 0 if valid.
is_valid_port_or_range() {
  local v="$1"
  if [[ "$v" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
    local a=${BASH_REMATCH[1]}
    local b=${BASH_REMATCH[2]}
    (( a >= 1 && a <= 65535 && b >= 1 && b <= 65535 && a <= b )) && return 0 || return 1
  elif [[ "$v" =~ ^([0-9]{1,5})$ ]]; then
    local p=${BASH_REMATCH[1]}
    (( p >= 1 && p <= 65535 )) && return 0 || return 1
  fi
  return 1
}

### PRE-CHECK ###
if [[ "$cmd" != "configure" && "$cmd" != "update" && "$cmd" != "help" && "$cmd" != "h" && "$cmd" != "version" ]]; then
  load_config || true
  require_config
fi

### IPTABLES ###
ensure_chains() {
  iptables -t nat -N MFW_PREROUTING 2>/dev/null || true
  iptables -N MFW_FORWARD 2>/dev/null || true

  iptables -t nat -C PREROUTING -j MFW_PREROUTING 2>/dev/null || \
    iptables -t nat -A PREROUTING -j MFW_PREROUTING

  iptables -C FORWARD -j MFW_FORWARD 2>/dev/null || \
    iptables -A FORWARD -j MFW_FORWARD
}

apply_rules() {
  require_config
  ensure_chains

  # Clear what is ours
  iptables -t nat -F MFW_PREROUTING
  iptables -F MFW_FORWARD

  # MASQUERADE for traffic coming from internal network
  iptables -t nat -C POSTROUTING -s "$DEST_NET" -o "$PUBLIC_IF" -j MASQUERADE 2>/dev/null || \
  iptables -t nat -A POSTROUTING -s "$DEST_NET" -o "$PUBLIC_IF" -j MASQUERADE

  while read -r p pt; do
    # Skip empty lines and comments
    [[ -z "$p" || "$p" =~ ^# ]] && continue

    # Sanitize: skip malformed entries
    if ! is_valid_proto "$p"; then
      echo "⚠️  Skipping invalid proto in rules file: '$p $pt'"
      continue
    fi
    if ! is_valid_port_or_range "$pt"; then
      echo "⚠️  Skipping invalid port in rules file: '$p $pt'"
      continue
    fi

    if [[ "$pt" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
      # Range: use native iptables range notation — no per-port loop needed
      local start_port=${BASH_REMATCH[1]}
      local end_port=${BASH_REMATCH[2]}

      iptables -t nat -A MFW_PREROUTING -i "$PUBLIC_IF" -p "$p" \
        --dport "$start_port:$end_port" \
        -j DNAT --to-destination "$DEST_HOST_IP:$start_port-$end_port"

      iptables -A MFW_FORWARD -i "$PUBLIC_IF" -o "$DEST_IF" -p "$p" \
        -d "$DEST_HOST_IP" --dport "$start_port:$end_port" \
        -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT

      iptables -A MFW_FORWARD -i "$DEST_IF" -o "$PUBLIC_IF" -p "$p" \
        -s "$DEST_HOST_IP" --sport "$start_port:$end_port" \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    else
      # Single port
      iptables -t nat -A MFW_PREROUTING -i "$PUBLIC_IF" -p "$p" \
        --dport "$pt" \
        -j DNAT --to-destination "$DEST_HOST_IP:$pt"

      iptables -A MFW_FORWARD -i "$PUBLIC_IF" -o "$DEST_IF" -p "$p" \
        -d "$DEST_HOST_IP" --dport "$pt" \
        -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT

      iptables -A MFW_FORWARD -i "$DEST_IF" -o "$PUBLIC_IF" -p "$p" \
        -s "$DEST_HOST_IP" --sport "$pt" \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    fi
  done < "$STATE_FILE"
}

### VERSION COMPARISON ###
# Compares two semver strings. Returns 0 if $1 < $2 (update available).
version_lt() {
  local a="$1" b="$2"
  # Split into major.minor.patch arrays
  IFS='.' read -r a1 a2 a3 <<< "$a"
  IFS='.' read -r b1 b2 b3 <<< "$b"
  # Default missing parts to 0
  a1=${a1:-0}; a2=${a2:-0}; a3=${a3:-0}
  b1=${b1:-0}; b2=${b2:-0}; b3=${b3:-0}

  if   (( a1 < b1 )); then return 0
  elif (( a1 > b1 )); then return 1
  elif (( a2 < b2 )); then return 0
  elif (( a2 > b2 )); then return 1
  elif (( a3 < b3 )); then return 0
  else return 1
  fi
}

### COMMANDS ###
update() {
  for dep in curl gpg; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      echo "✖ $dep not found. Please install $dep first."
      exit 1
    fi
  done

  echo "↪ Fetching latest release from GitHub..."

  TMP_REMOTE="$(mktemp)"
  TMP_SIG="$(mktemp)"
  TMP_GNUPGHOME="$(mktemp -d)"
  trap 'rm -rf "$TMP_GNUPGHOME"; rm -f "$TMP_REMOTE" "$TMP_SIG"' EXIT

  if ! curl -fsSL "$GH_RAW_URL" -o "$TMP_REMOTE" 2>/dev/null; then
    echo "✖ Failed to reach GitHub. Check your internet connection."
    exit 1
  fi
  [[ ! -s "$TMP_REMOTE" ]] && { echo "✖ Downloaded file is empty or invalid."; exit 1; }

  if ! curl -fsSL "$GH_SIG_URL" -o "$TMP_SIG" 2>/dev/null; then
    echo "✖ Failed to download the release signature (.sig)."
    echo "  The release may not have been signed yet. Aborting."
    exit 1
  fi
  [[ ! -s "$TMP_SIG" ]] && { echo "✖ Signature file is empty or invalid."; exit 1; }

  # --- GPG verification in an isolated, ephemeral keyring ---
  echo "↪ Verifying GPG signature..."

  chmod 700 "$TMP_GNUPGHOME"

  # Import only the key embedded in this binary — no external keyserver calls
  if ! GNUPGHOME="$TMP_GNUPGHOME" gpg --batch --quiet \
      --import <<< "$MFW_SIGNING_KEY" 2>/dev/null; then
    echo "✖ Failed to import the embedded signing key."
    exit 1
  fi

  # Verify the fingerprint of the imported key matches what this binary expects.
  # This prevents a tampered script (with a replaced key + matching signature)
  # from passing verification when the installed binary is still trustworthy.
  IMPORTED_FP=$(GNUPGHOME="$TMP_GNUPGHOME" gpg --batch --quiet \
    --with-colons --fingerprint 2>/dev/null \
    | awk -F: '/^fpr/ { print $10; exit }')

  if [[ "$IMPORTED_FP" != "$MFW_SIGNING_FINGERPRINT" ]]; then
    echo "✖ Signing key fingerprint mismatch!"
    echo "  Expected : $MFW_SIGNING_FINGERPRINT"
    echo "  Got      : $IMPORTED_FP"
    echo "  This binary may have been tampered with."
    exit 1
  fi

  # Verify the detached signature against the downloaded file.
  # --trust-model direct: trust any key explicitly present in this keyring,
  # bypassing the web-of-trust (appropriate since we control the keyring).
  if ! GNUPGHOME="$TMP_GNUPGHOME" gpg --batch --quiet \
      --trust-model direct \
      --verify "$TMP_SIG" "$TMP_REMOTE" 2>/dev/null; then
    echo "✖ Signature verification FAILED."
    echo "  The downloaded file does not match the release signature."
    echo "  It may be corrupted or tampered with. Aborting."
    exit 1
  fi

  echo "✔ Signature verified (key: ${MFW_SIGNING_FINGERPRINT:0:16}...)"

  # --- Version check (after verification, not before) ---
  REMOTE_VERSION=$(grep -m1 '^MFW_VERSION=' "$TMP_REMOTE" | cut -d'"' -f2)
  if [[ -z "$REMOTE_VERSION" ]]; then
    echo "✖ Could not determine remote version. The file may be malformed."
    exit 1
  fi

  echo "  Installed version : $MFW_VERSION"
  echo "  Remote version    : $REMOTE_VERSION"
  echo

  if ! version_lt "$MFW_VERSION" "$REMOTE_VERSION"; then
    echo "✔ Already up to date."
    exit 0
  fi

  echo "  New version available: $MFW_VERSION → $REMOTE_VERSION"
  echo
  read -rp "Update now? [Y/n]: " confirm
  confirm="${confirm:-Y}"
  if ! [[ "$confirm" =~ ^[Yy]$ ]]; then
    echo "↩ Update cancelled."
    exit 0
  fi

  # Atomic replace
  chmod +x "$TMP_REMOTE"
  install -m 755 "$TMP_REMOTE" "$BIN_DST"

  echo "✔ Updated to v$REMOTE_VERSION"
}

configure() {
  load_config || true

  read -rp "Public interface [$PUBLIC_IF]: " input
  PUBLIC_IF="${input:-$PUBLIC_IF}"

  read -rp "Destination interface [$DEST_IF]: " input
  DEST_IF="${input:-$DEST_IF}"

  read -rp "Destination IP (CIDR, ex: 100.64.0.2/24) [$DEST_IP]: " input
  DEST_IP="${input:-$DEST_IP}"

  if ! [[ "$DEST_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]]; then
    echo "✖ Invalid CIDR format: $DEST_IP"
    exit 1
  fi

  echo
  echo "  Public interface  : $PUBLIC_IF"
  echo "  Destination iface : $DEST_IF"
  echo "  Destination IP    : $DEST_IP"
  echo

  read -rp "Confirm and apply? [Y/n]: " confirm
  confirm="${confirm:-Y}"
  if ! [[ "$confirm" =~ ^[Yy]$ ]]; then
    echo "↩ Aborted. No changes made."
    exit 0
  fi

  # Apply sysctl immediately
  sysctl -w net.ipv4.ip_forward=1 >/dev/null
  sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null
  sysctl -w net.ipv4.conf."$PUBLIC_IF".rp_filter=0 >/dev/null

  # Persist sysctl across reboots
  cat > "$SYSCTL_FILE" <<EOF
# MFW - Minimal Forward Wrapper
net.ipv4.ip_forward = 1
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.$PUBLIC_IF.rp_filter = 0
EOF
  chmod 644 "$SYSCTL_FILE"

  # Save config
  cat > "$CONFIG_FILE" <<EOF
# mfw configuration — do not edit manually
PUBLIC_IF="$PUBLIC_IF"
DEST_IF="$DEST_IF"
DEST_IP="$DEST_IP"
EOF
  chmod 600 "$CONFIG_FILE"

  echo "✔ Configuration saved"
  echo "✔ sysctl persisted to $SYSCTL_FILE"
  echo "↪ Reloading rules..."
  apply_rules
  echo "✔ Done"
}

status() {
  load_config || true

  # Config summary
  if [[ -z "$PUBLIC_IF" || -z "$DEST_IF" || -z "$DEST_IP" ]]; then
    echo "Configuration  : ✖ not configured (run: mfw configure)"
  else
    echo "Input iface      : $PUBLIC_IF"
    echo "Output iface     : $DEST_IF"
    echo "Destination IP   : $DEST_IP"

    # Count active iptables rules in our chains
    nat_count=$(iptables -t nat -L MFW_PREROUTING 2>/dev/null | grep -c DNAT || true)
    fwd_count=$(iptables -L MFW_FORWARD 2>/dev/null | grep -c ACCEPT || true)
    echo "Active rules     : $nat_count DNAT, $fwd_count FORWARD"
  fi

  echo "---------------"

  # Rule table
  if [[ ! -s "$STATE_FILE" ]]; then
    echo "(no forwarding rules configured)"
  else
    echo "PROTO  PORT"
    echo "---------------"
    while read -r p pt; do
      [[ -z "$p" || "$p" =~ ^# ]] && continue
      printf "  %-6s %s\n" "$p" "$pt"
    done < "$STATE_FILE"
  fi
}

case "$cmd" in
  a) cmd=add ;;
  d|delete) cmd=del ;;
  v) cmd=version ;;
  r) cmd=reload ;;
  s) cmd=status ;;
  config) cmd=configure ;;
  h) cmd=help ;;
 esac

case "$cmd" in
  help)
    help "$2"
    ;;
  add)
    [[ -z "$proto" || -z "$port" ]] && help add

    if ! is_valid_proto "$proto"; then
      echo "✖ Invalid protocol: '$proto'. Use tcp or udp."
      exit 1
    fi
    if ! is_valid_port_or_range "$port"; then
      echo "✖ Invalid port or range: '$port'"
      exit 1
    fi
    if grep -q "^$proto $port$" "$STATE_FILE"; then
      echo "⚠️  $port/$proto already exists"
      exit 0
    fi

    echo "$proto $port" >> "$STATE_FILE"
    apply_rules
    echo "✔ Added: $port/$proto"
    ;;

  del)
    [[ -z "$proto" || -z "$port" ]] && help del

    if ! is_valid_proto "$proto"; then
      echo "✖ Invalid protocol: '$proto'. Use tcp or udp."
      exit 1
    fi
    if ! is_valid_port_or_range "$port"; then
      echo "✖ Invalid port or range: '$port'"
      exit 1
    fi
    if ! grep -q "^$proto $port$" "$STATE_FILE"; then
      echo "⚠️  $port/$proto does not exist."
      exit 1
    fi

    sed -i "/^$proto $port$/d" "$STATE_FILE"
    apply_rules
    echo "✔ Removed: $port/$proto"
    ;;

  status)
    status
    ;;

  reload)
    apply_rules
    echo "✔ Reloaded all rules"
    ;;

  configure)
    configure
    ;;

  update)
    update
    ;;

  version)
    echo "$MFW_VERSION"
    ;;

  *)
    help
    ;;
esac
