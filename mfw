#!/bin/bash
set -e

### VERSION ###
MFW_VERSION="1.3.0"

### CHECK ROOT ###
if [[ "$EUID" -ne 0 ]]; then
  echo "error: you cannot perform this operation unless you are root"
  exit 1
fi

### CHECK DEPENDENCIES ###
if ! command -v iptables >/dev/null 2>&1; then
  echo "✖ iptables not found. Please install iptables first."
  exit 1
fi

### PATHS ###
BIN_DST="/usr/local/bin/mfw"
STATE_DIR="/etc/mfw"
STATE_FILE="$STATE_DIR/rules.conf"
CONFIG_FILE="$STATE_DIR/config.conf"
SYSCTL_FILE="/etc/sysctl.d/99-mfw.conf"

### GITHUB ###
GH_REPO="debelzak/mfw"
GH_RAW_URL="https://raw.githubusercontent.com/$GH_REPO/main/mfw"
GH_SIG_URL="${GH_RAW_URL}.sig"

### SIGNING KEY ###
# This public key is embedded here intentionally.
# It is used to verify the integrity and authenticity of updates before
# any downloaded code is executed. The private key never leaves the
# maintainer's machine. To verify this key independently:
#   gpg --keyserver keys.openpgp.org --recv-keys <FINGERPRINT>
#
# Replace the fingerprint and key block below with your own before publishing.
MFW_SIGNING_FINGERPRINT="C8FC9F1B3A1973144BDD99E3FE18E4D17EF64E7E"
MFW_SIGNING_KEY='-----BEGIN PGP PUBLIC KEY BLOCK-----

mDMEajP9tRYJKwYBBAHaRw8BAQdAtetscxL+/E2xBeIxvHmK8ud1o6FxABE7W9Hy
