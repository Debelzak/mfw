#!/bin/bash
set -e

### VERSION ###
MFW_VERSION="2.0.0"

### Privilege helpers ###
require_root() {
  if [[ "$EUID" -ne 0 ]]; then
    echo "error: you cannot perform this operation unless you are root"
    exit 1
  fi
}

### BOOTSTRAP (deferred until we need to write system paths) ###
bootstrap() {
  mkdir -p "$STATE_DIR"
  chmod 755 "$STATE_DIR"
  touch "$STATE_FILE"
  chmod 600 "$STATE_FILE"
}

### PATHS ###
BIN_DST="/usr/local/bin/mfw"
STATE_DIR="/etc/mfw"
STATE_FILE="$STATE_DIR/rules.conf"
CONFIG_FILE="$STATE_DIR/config.conf"
SYSCTL_FILE="/etc/sysctl.d/99-mfw.conf"
DEST_CIDR_BITS=24

### GITHUB ###
GH_REPO="debelzak/mfw"
# Use GitHub Releases API to discover latest release and assets
GH_API_URL="https://api.github.com/repos/$GH_REPO/releases/latest"

