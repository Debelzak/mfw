### ARGUMENTS ###
cmd="$1"
proto="$2"
port="$3"
dest="$4"

### HELP ###
help() {
  local cmd="$1"

  case "$cmd" in
    add)        help_add ;;
    del)        help_del ;;
    status)     help_status ;;
    reload)     help_reload ;;
    configure)  help_configure ;;
    update)     help_update ;;
    ""|help|*)  help_main ;;
  esac

  exit 1
}

help_main() {
  cat <<EOF
Usage:
  mfw <command> [options]

Available Commands:
  version        Prints the current version
  add            Adds a TCP or UDP port forwarding rule
  delete         Removes an existing forwarding rule
  status         Lists all configured forwarding rules and current config
  reload         Reloads and reapplies all firewall rules
  configure      Starts the interactive configuration wizard
  update         Checks for a newer version and updates if available
EOF
}

help_add() {
  cat <<EOF
Usage:
  mfw add <tcp|udp> <port> [dest_ip[/cidr]]

Aliases:
  add, a

Adds a TCP or UDP port forwarding rule. You may specify a single port
or a port range using the format "start-end" (example: 12621-12631).

The destination is stored per rule, so multiple destinations can coexist
by using the format:
  mfw add tcp 80 10.226.10.2/24

Legacy behavior is still accepted when the destination is omitted and the
previous global configuration still provides DEST_IP/DEST_CIDR_BITS.

Examples:
  mfw add tcp 25565 10.226.10.2/24
  mfw add udp 12621-12631 10.226.10.3/24
EOF
}

help_del() {
  cat <<EOF
Usage:
  mfw del <tcp|udp> <port> [dest_ip[/cidr]]

Aliases:
  delete, del, d

Removes an existing forwarding rule. If the rule was added as a range,
pass the same range to remove it (exact match required). When the
(optional) destination is omitted, all matching rules for that protocol
and port are removed, which keeps older workflows backward compatible.

Examples:
  mfw del udp 16261
  mfw del tcp 12621-12631 10.226.10.2/24
EOF
}

help_status() {
  cat <<EOF
Usage:
  mfw status

Aliases:
  status, s

Lists all configured forwarding rules and active configuration.
EOF
}

help_reload() {
  cat <<EOF
Usage:
  mfw reload

Aliases:
  reload, r

Reloads and reapplies all firewall rules.
EOF
}

help_configure() {
  cat <<EOF
Usage:
  mfw configure

Aliases:
  configure, config

Starts the interactive configuration wizard.
EOF
}

help_update() {
  cat <<EOF
Usage:
  mfw update

Checks GitHub for a newer release and, if one is found, downloads it,
verifies its GPG signature against the key embedded in this binary, and
only then replaces the current installation.

The update is aborted if:
  - the signature file is missing or invalid
  - the signature does not match the downloaded file
  - the signing key fingerprint does not match the expected value

The running configuration and rules are always preserved.
EOF
}

### Note: Bootstrap is called only for commands that require root. ###

### CONFIG LOAD ###
load_config() {
  # shellcheck source=/dev/null
  [[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
}

normalize_destination_spec() {
  local dest_spec="$1"
  local ip="${DEST_IP:-}"
  local cidr_bits="${DEST_CIDR_BITS:-24}"

  if [[ -n "$dest_spec" ]]; then
    if [[ "$dest_spec" == */* ]]; then
      ip="${dest_spec%/*}"
      cidr_bits="${dest_spec##*/}"
    else
      ip="$dest_spec"
    fi
  fi

  [[ -n "$ip" ]] || return 1

  if ! is_valid_ipv4 "$ip"; then
    echo "✖ Invalid destination IP: $ip"
    return 1
  fi

  if ! is_valid_cidr_bits "$cidr_bits"; then
    echo "✖ Invalid CIDR bits: $cidr_bits (must be 0-32)"
    return 1
  fi

  printf '%s/%s' "$ip" "$cidr_bits"
}

resolve_rule_target() {
  local dest_spec="$1"
  local normalized

  normalized="$(normalize_destination_spec "$dest_spec")" || return 1

  DEST_TARGET_IP="${normalized%/*}"
  DEST_TARGET_CIDR_BITS="${normalized##*/}"
  derive_network "$DEST_TARGET_IP" "$DEST_TARGET_CIDR_BITS"
}

migrate_legacy_rules() {
  [[ -r "$STATE_FILE" ]] || return 0
  [[ -n "$DEST_IP" ]] || return 0

  local tmp_file
  tmp_file=$(mktemp)
  local migrated=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" || "$line" =~ ^# ]]; then
      printf '%s\n' "$line" >> "$tmp_file"
      continue
    fi

    if [[ "$line" =~ ^([[:space:]]*)(tcp|udp)([[:space:]]+)([0-9]{1,5})([[:space:]]*)(.*)$ ]]; then
      local proto_key="${BASH_REMATCH[2]}"
      local port_key="${BASH_REMATCH[4]}"
      local rest="${BASH_REMATCH[6]}"

      if [[ -z "$rest" ]]; then
        printf '%s %s %s/%s\n' "$proto_key" "$port_key" "$DEST_IP" "$DEST_CIDR_BITS" >> "$tmp_file"
        migrated=1
      else
        printf '%s\n' "$line" >> "$tmp_file"
      fi
    else
      printf '%s\n' "$line" >> "$tmp_file"
    fi
  done < "$STATE_FILE"

  if (( migrated )); then
    mv "$tmp_file" "$STATE_FILE"
    chmod 600 "$STATE_FILE"
  else
    rm -f "$tmp_file"
  fi
}

### DERIVE NETWORK BASED ON CIDR ###
derive_network() {
  local ip="${1:-$DEST_IP}"
  local cidr_bits="${2:-${DEST_CIDR_BITS:-24}}"

  IFS=. read -r i1 i2 i3 i4 <<< "$ip"

  IP=$(( (i1<<24) | (i2<<16) | (i3<<8) | i4 ))
  MASK=$(( (0xFFFFFFFF << (32 - cidr_bits)) & 0xFFFFFFFF ))
  NET=$(( IP & MASK ))

  NET_IP=$(printf "%d.%d.%d.%d" \
    $(( (NET >> 24) & 255 )) \
    $(( (NET >> 16) & 255 )) \
    $(( (NET >> 8) & 255 )) \
    $(( NET & 255 ))
  )

  DEST_NET="$NET_IP/$cidr_bits"
}

### VALIDATION ###
require_config() {
  [[ -z "$PUBLIC_IF" || -z "$DEST_IF" ]] && {
    echo "✖ Incomplete configuration."
    echo "  Run: mfw configure"
    exit 1
  }

  if [[ -n "$DEST_IP" ]]; then
    if ! is_valid_ipv4 "$DEST_IP"; then
      echo "✖ Invalid destination IP: $DEST_IP"
      exit 1
    fi

    if ! is_valid_cidr_bits "$DEST_CIDR_BITS"; then
      echo "✖ Invalid CIDR bits: $DEST_CIDR_BITS (must be 0-32)"
      exit 1
    fi
  fi
}

is_valid_ipv4() {
  local ip="$1"
  local octet

  [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for octet in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
    (( octet >= 0 && octet <= 255 )) || return 1
  done
  return 0
}

is_valid_cidr_bits() {
  [[ "$1" =~ ^[0-9]{1,2}$ ]] && (( $1 >= 0 && $1 <= 32 ))
}

# Validate protocol: must be tcp or udp
is_valid_proto() {
  [[ "$1" =~ ^(tcp|udp)$ ]]
}

# Validate a single port or a port range (start-end). Returns 0 if valid.
is_valid_port_or_range() {
  local v="$1"
  if [[ "$v" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
    local a=${BASH_REMATCH[1]}
    local b=${BASH_REMATCH[2]}
    (( a >= 1 && a <= 65535 && b >= 1 && b <= 65535 && a <= b )) && return 0 || return 1
  elif [[ "$v" =~ ^([0-9]{1,5})$ ]]; then
    local p=${BASH_REMATCH[1]}
    (( p >= 1 && p <= 65535 )) && return 0 || return 1
  fi
  return 1
}

### PRE-CHECK ###
# Only auto-load config for `status` which may run unprivileged.
if [[ "$cmd" == "status" ]]; then
  load_config || true
fi

### IPTABLES ###
ensure_chains() {
  if ! command -v iptables >/dev/null 2>&1; then
    echo "✖ iptables not found. Please install iptables first."
    exit 1
  fi
  iptables -t nat -N MFW_PREROUTING 2>/dev/null || true
  iptables -N MFW_FORWARD 2>/dev/null || true

  iptables -t nat -C PREROUTING -j MFW_PREROUTING 2>/dev/null || \
    iptables -t nat -A PREROUTING -j MFW_PREROUTING

  iptables -C FORWARD -j MFW_FORWARD 2>/dev/null || \
    iptables -A FORWARD -j MFW_FORWARD
}

apply_rules() {
  require_config
  ensure_chains

  # Clear what is ours
  iptables -t nat -F MFW_PREROUTING
  iptables -F MFW_FORWARD

  while read -r p pt rule_target; do
    # Skip empty lines and comments
    [[ -z "$p" || "$p" =~ ^# ]] && continue

    # Sanitize: skip malformed entries
    if ! is_valid_proto "$p"; then
      echo "⚠️  Skipping invalid proto in rules file: '$p $pt $rule_target'"
      continue
    fi
    if ! is_valid_port_or_range "$pt"; then
      echo "⚠️  Skipping invalid port in rules file: '$p $pt $rule_target'"
      continue
    fi

    if [[ -n "$rule_target" ]]; then
      if ! resolve_rule_target "$rule_target"; then
        echo "⚠️  Skipping invalid destination in rules file: '$p $pt $rule_target'"
        continue
      fi
    else
      if [[ -z "$DEST_IP" ]]; then
        echo "⚠️  Skipping rule without destination: '$p $pt'"
        continue
      fi
      resolve_rule_target "$DEST_IP/$DEST_CIDR_BITS"
    fi

    # MASQUERADE for traffic coming from internal network
    iptables -t nat -C POSTROUTING -s "$DEST_NET" -o "$PUBLIC_IF" -j MASQUERADE 2>/dev/null || \
    iptables -t nat -A POSTROUTING -s "$DEST_NET" -o "$PUBLIC_IF" -j MASQUERADE

    if [[ "$pt" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
      # Range: use native iptables range notation — no per-port loop needed
      local start_port=${BASH_REMATCH[1]}
      local end_port=${BASH_REMATCH[2]}

      iptables -t nat -A MFW_PREROUTING -i "$PUBLIC_IF" -p "$p" \
        --dport "$start_port:$end_port" \
        -j DNAT --to-destination "$DEST_TARGET_IP:$start_port-$end_port"

      iptables -A MFW_FORWARD -i "$PUBLIC_IF" -o "$DEST_IF" -p "$p" \
        -d "$DEST_TARGET_IP" --dport "$start_port:$end_port" \
        -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT

      iptables -A MFW_FORWARD -i "$DEST_IF" -o "$PUBLIC_IF" -p "$p" \
        -s "$DEST_TARGET_IP" --sport "$start_port:$end_port" \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    else
      # Single port
      iptables -t nat -A MFW_PREROUTING -i "$PUBLIC_IF" -p "$p" \
        --dport "$pt" \
        -j DNAT --to-destination "$DEST_TARGET_IP:$pt"

      iptables -A MFW_FORWARD -i "$PUBLIC_IF" -o "$DEST_IF" -p "$p" \
        -d "$DEST_TARGET_IP" --dport "$pt" \
        -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT

      iptables -A MFW_FORWARD -i "$DEST_IF" -o "$PUBLIC_IF" -p "$p" \
        -s "$DEST_TARGET_IP" --sport "$pt" \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    fi
  done < "$STATE_FILE"
}

### VERSION COMPARISON ###
# Compares two semver strings. Returns 0 if $1 < $2 (update available).
version_lt() {
  local a="$1" b="$2"
  # Split into major.minor.patch arrays
  IFS='.' read -r a1 a2 a3 <<< "$a"
  IFS='.' read -r b1 b2 b3 <<< "$b"
  # Default missing parts to 0
  a1=${a1:-0}; a2=${a2:-0}; a3=${a3:-0}
  b1=${b1:-0}; b2=${b2:-0}; b3=${b3:-0}

  if   (( a1 < b1 )); then return 0
  elif (( a1 > b1 )); then return 1
  elif (( a2 < b2 )); then return 0
  elif (( a2 > b2 )); then return 1
  elif (( a3 < b3 )); then return 0
  else return 1
  fi
}

### COMMANDS ###
update() {
  for dep in curl gpg perl; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      echo "✖ $dep not found. Please install $dep first."
      exit 1
    fi
  done

  echo "↪ Fetching latest release metadata from GitHub..."

  TMP_JSON="$(mktemp)"
  TMP_REMOTE="$(mktemp)"
  TMP_SIG="$(mktemp)"
  TMP_GNUPGHOME="$(mktemp -d)"
  trap 'rm -rf "$TMP_GNUPGHOME"; rm -f "$TMP_JSON" "$TMP_REMOTE" "$TMP_SIG"' EXIT

  if ! curl -fsSL -o "$TMP_JSON" "$GH_API_URL" 2>/dev/null; then
    echo "✖ Failed to reach GitHub. Check your internet connection."
    exit 1
  fi
  [[ ! -s "$TMP_JSON" ]] && { echo "✖ Failed to fetch release metadata."; exit 1; }

  # Parse remote tag and strip leading 'v' if present
  REMOTE_TAG=$(perl -0777 -ne 'print $1 if /"tag_name"\s*:\s*"(v?[^\"]+)"/s' "$TMP_JSON" || true)
  REMOTE_VERSION="${REMOTE_TAG#v}"
  if [[ -z "$REMOTE_VERSION" ]]; then
    echo "✖ Could not determine remote version."
    exit 1
  fi

  # Extract asset download URLs for 'mfw' and 'mfw.sig' without jq
  MFW_URL=$(perl -0777 -ne 'print $1 if /"name"\s*:\s*"mfw".*?"browser_download_url"\s*:\s*"([^\"]+)"/s' "$TMP_JSON" || true)
  SIG_URL=$(perl -0777 -ne 'print $1 if /"name"\s*:\s*"mfw.sig".*?"browser_download_url"\s*:\s*"([^\"]+)"/s' "$TMP_JSON" || true)

  if [[ -z "$MFW_URL" || -z "$SIG_URL" ]]; then
    echo "✖ Could not find release assets (mfw and mfw.sig) in latest release."
    exit 1
  fi

  if ! version_lt "$MFW_VERSION" "$REMOTE_VERSION"; then
    echo "✔ Already up to date."
    exit 0
  fi

  echo "  New version available: $MFW_VERSION → $REMOTE_VERSION"
  echo

  # Download assets (already validated via API parsing)
  if ! curl -fsSL -o "$TMP_REMOTE" "$MFW_URL" 2>/dev/null; then
    echo "✖ Failed to download asset: $MFW_URL"
    exit 1
  fi
  [[ ! -s "$TMP_REMOTE" ]] && { echo "✖ Downloaded file is empty or invalid."; exit 1; }

  if ! curl -fsSL -o "$TMP_SIG" "$SIG_URL" 2>/dev/null; then
    echo "✖ Failed to download signature: $SIG_URL"
    exit 1
  fi
  [[ ! -s "$TMP_SIG" ]] && { echo "✖ Signature file is empty or invalid."; exit 1; }

  # --- GPG verification in an isolated, ephemeral keyring ---
  echo "↪ Verifying GPG signature..."

  chmod 700 "$TMP_GNUPGHOME"

  if ! GNUPGHOME="$TMP_GNUPGHOME" gpg --batch --quiet \
      --import <<< "$MFW_SIGNING_KEY" 2>/dev/null; then
    echo "✖ Failed to import the embedded signing key."
    exit 1
  fi

  IMPORTED_FP=$(GNUPGHOME="$TMP_GNUPGHOME" gpg --batch --quiet \
    --with-colons --fingerprint 2>/dev/null \
    | awk -F: '/^fpr/ { print $10; exit }')

  if [[ "$IMPORTED_FP" != "$MFW_SIGNING_FINGERPRINT" ]]; then
    echo "✖ Signing key fingerprint mismatch!"
    echo "  Expected : $MFW_SIGNING_FINGERPRINT"
    echo "  Got      : $IMPORTED_FP"
    echo "  This binary may have been tampered with."
    exit 1
  fi

  if ! GNUPGHOME="$TMP_GNUPGHOME" gpg --batch --quiet \
      --trust-model direct \
      --verify "$TMP_SIG" "$TMP_REMOTE" 2>/dev/null; then
    echo "✖ Signature verification FAILED."
    echo "  The downloaded file does not match the release signature."
    echo "  It may be corrupted or tampered with. Aborting."
    exit 1
  fi

  echo "✔ Signature verified (key: ${MFW_SIGNING_FINGERPRINT:0:16}...)"

  read -rp "Update now? [Y/n]: " confirm
  confirm="${confirm:-Y}"
  if ! [[ "$confirm" =~ ^[Yy]$ ]]; then
    echo "↩ Update cancelled."
    exit 0
  fi

  chmod +x "$TMP_REMOTE"
  install -m 755 "$TMP_REMOTE" "$BIN_DST"

  echo "✔ Updated to v$REMOTE_VERSION"
}

configure() {
  load_config || true

  read -rp "Public interface [$PUBLIC_IF]: " input
  PUBLIC_IF="${input:-$PUBLIC_IF}"

  read -rp "Destination interface [$DEST_IF]: " input
  DEST_IF="${input:-$DEST_IF}"

  if [[ -n "$DEST_IP" ]] && ! is_valid_ipv4 "$DEST_IP"; then
    echo "✖ Invalid legacy destination IP: $DEST_IP"
    exit 1
  fi

  if [[ -n "$DEST_CIDR_BITS" ]] && ! is_valid_cidr_bits "$DEST_CIDR_BITS"; then
    echo "✖ Invalid legacy CIDR bits: $DEST_CIDR_BITS (must be 0-32)"
    exit 1
  fi

  echo
  echo "  Public interface  : $PUBLIC_IF"
  echo "  Destination iface : $DEST_IF"
  echo

  read -rp "Confirm and apply? [Y/n]: " confirm
  confirm="${confirm:-Y}"
  if ! [[ "$confirm" =~ ^[Yy]$ ]]; then
    echo "↩ Aborted. No changes made."
    exit 0
  fi

  # Apply sysctl immediately
  sysctl -w net.ipv4.ip_forward=1 >/dev/null
  sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null
  sysctl -w net.ipv4.conf."$PUBLIC_IF".rp_filter=0 >/dev/null

  # Persist sysctl across reboots
  (
    flock -n 9 || { echo "✖ Could not lock $SYSCTL_FILE"; exit 1; }
    cat > "$SYSCTL_FILE" <<EOF
# MFW - Minimal Forward Wrapper
net.ipv4.ip_forward = 1
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.$PUBLIC_IF.rp_filter = 0
EOF
    chmod 644 "$SYSCTL_FILE"
  ) 9>"$SYSCTL_FILE.lock"

  # Save config
  (
    flock -n 9 || { echo "✖ Could not lock $CONFIG_FILE"; exit 1; }
    cat > "$CONFIG_FILE" <<EOF
# mfw configuration — do not edit manually
PUBLIC_IF="$PUBLIC_IF"
DEST_IF="$DEST_IF"
DEST_IP="$DEST_IP"
DEST_CIDR_BITS="$DEST_CIDR_BITS"
EOF
    chmod 644 "$CONFIG_FILE"
  ) 9>"$CONFIG_FILE.lock"

  echo "✔ Configuration saved"
  echo "✔ sysctl persisted to $SYSCTL_FILE"
  echo "↪ Reloading rules..."
  migrate_legacy_rules || true
  apply_rules
  echo "✔ Done"
}

status() {
  load_config || true

  # Config summary
  if [[ -z "$PUBLIC_IF" || -z "$DEST_IF" ]]; then
    echo "Configuration  : ✖ not configured (run: mfw configure)"
  else
    echo "Input iface      : $PUBLIC_IF"
    echo "Output iface     : $DEST_IF"
    if [[ -n "$DEST_IP" ]]; then
      echo "Legacy target    : $DEST_IP/$DEST_CIDR_BITS"
    fi

    # Count active iptables rules in our chains
    nat_count=$(iptables -t nat -L MFW_PREROUTING 2>/dev/null | grep -c DNAT || true)
    fwd_count=$(iptables -L MFW_FORWARD 2>/dev/null | grep -c ACCEPT || true)
    echo "Active rules     : $nat_count DNAT, $fwd_count FORWARD"
  fi

  echo "---------------"

  # Rule table
  if [[ ! -s "$STATE_FILE" ]]; then
    echo "(no forwarding rules configured)"
  else
    echo "PROTO  PORT    DESTINATION"
    echo "---------------"
    while read -r p pt rule_target; do
      [[ -z "$p" || "$p" =~ ^# ]] && continue
      printf "  %-6s %-6s %s\n" "$p" "$pt" "${rule_target:-$DEST_IP/$DEST_CIDR_BITS}"
    done < "$STATE_FILE"
  fi
}

case "$cmd" in
  a) cmd=add ;;
  d|delete) cmd=del ;;
  v) cmd=version ;;
  r) cmd=reload ;;
  s) cmd=status ;;
  config) cmd=configure ;;
  h) cmd=help ;;
 esac

case "$cmd" in
  help)
    help "$2"
    ;;
  add)
    [[ -z "$proto" || -z "$port" ]] && help add

    require_root
    bootstrap
    load_config || true
    migrate_legacy_rules || true
    require_config

    if ! is_valid_proto "$proto"; then
      echo "✖ Invalid protocol: '$proto'. Use tcp or udp."
      exit 1
    fi
    if ! is_valid_port_or_range "$port"; then
      echo "✖ Invalid port or range: '$port'"
      exit 1
    fi

    resolved_dest=""
    if [[ -n "$dest" ]]; then
      resolved_dest="$(normalize_destination_spec "$dest")" || {
        echo "✖ Invalid destination target: '$dest'"
        exit 1
      }
    elif [[ -n "$DEST_IP" ]]; then
      resolved_dest="$(normalize_destination_spec "$DEST_IP/$DEST_CIDR_BITS")"
    fi

    if [[ -z "$resolved_dest" ]]; then
      echo "✖ Destination is required for new rules. Use: mfw add $proto $port <ip/cidr>"
      exit 1
    fi

    (
      flock -n 9 || { echo "✖ Could not lock $STATE_FILE"; exit 1; }

      if grep -q "^$proto $port $resolved_dest$" "$STATE_FILE"; then
        echo "⚠️  $port/$proto for $resolved_dest already exists"
        exit 0
      fi

      if grep -q "^$proto $port$" "$STATE_FILE"; then
        sed -i "s|^$proto $port$|$proto $port $resolved_dest|" "$STATE_FILE"
      else
        echo "$proto $port $resolved_dest" >> "$STATE_FILE"
      fi
    ) 9>"$STATE_FILE.lock"

    apply_rules
    echo "✔ Added: $port/$proto -> $resolved_dest"
    ;;

  del)
    [[ -z "$proto" || -z "$port" ]] && help del

    require_root
    bootstrap
    load_config || true
    migrate_legacy_rules || true
    require_config

    if ! is_valid_proto "$proto"; then
      echo "✖ Invalid protocol: '$proto'. Use tcp or udp."
      exit 1
    fi
    if ! is_valid_port_or_range "$port"; then
      echo "✖ Invalid port or range: '$port'"
      exit 1
    fi
    (
      flock -n 9 || { echo "✖ Could not lock $STATE_FILE"; exit 1; }

      if [[ -n "$dest" ]]; then
        resolved_dest="$(normalize_destination_spec "$dest")" || {
          echo "✖ Invalid destination target: '$dest'"
          exit 1
        }
        if ! grep -q "^$proto $port $resolved_dest$" "$STATE_FILE"; then
          echo "⚠️  $port/$proto for $resolved_dest does not exist."
          exit 1
        fi
        sed -i "/^$proto $port $resolved_dest$/d" "$STATE_FILE"
      else
        if ! grep -q "^$proto $port" "$STATE_FILE"; then
          echo "⚠️  $port/$proto does not exist."
          exit 1
        fi
        sed -i "/^$proto $port\([[:space:]]\|$\)/d" "$STATE_FILE"
      fi
    ) 9>"$STATE_FILE.lock"

    apply_rules
    echo "✔ Removed: $port/$proto"
    ;;

  status)
    status
    ;;

  reload)
    require_root
    bootstrap
    load_config || true
    migrate_legacy_rules || true
    require_config
    apply_rules
    echo "✔ Reloaded all rules"
    ;;

  configure)
    require_root
    bootstrap
    configure
    ;;

  update)
    require_root
    update
    ;;

  version)
    echo "$MFW_VERSION"
    ;;

  *)
    help
    ;;
esac
